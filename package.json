{
  "name": "reconcile",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --filter ./packages/* build && pnpm --filter @reconcile/web dev",
